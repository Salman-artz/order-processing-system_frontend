# ==============================================================
# WarehouseFlow Frontend — Environment Configuration (.env.local)
# ==============================================================

# API Base URL (Order Service Gateway on host port 8085)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8085/api/v1

# Real-time WebSocket URL (Notification Service)
NEXT_PUBLIC_WS_URL=ws://localhost:8083

# Production / Mock Toggle (Set false for real microservice cluster)
NEXT_PUBLIC_USE_MOCK=false
